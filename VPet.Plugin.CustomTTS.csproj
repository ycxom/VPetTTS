<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DesignTimeBuild>true</DesignTimeBuild>
    <LangVersion>11.0</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="1102_VPetTTS\**" />
    <EmbeddedResource Remove="1102_VPetTTS\**" />
    <Page Remove="1102_VPetTTS\**" />
    <None Include="1102_VPetTTS\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自带的原生鉴权组件按进程架构加载；它的位置也决定请求身份（mod_id）。 -->
    <None Update="Native\win-x64\VPetLLM.SecureCommunication.dll"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="runtimes\win-x64\native\VPetLLM.SecureCommunication.dll" />
    <None Update="Native\win-x86\VPetLLM.SecureCommunication.dll"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="runtimes\win-x86\native\VPetLLM.SecureCommunication.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="LinePutScript" Version="1.11.9" />
    <PackageReference Include="LinePutScript.Localization.WPF" Version="1.0.7" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="VPet-Simulator.Core" Version="1.1.0.58" />
    <PackageReference Include="VPet-Simulator.Windows.Interface" Version="1.1.0.58" />
  </ItemGroup>
  
  <!-- 编译后自动复制 DLL 到 plugin 目录 -->
  <Target Name="CopyToPlugin" AfterTargets="Build">
    <MakeDir Directories="$(ProjectDir)1102_VPetTTS\plugin\" Condition="!Exists('$(ProjectDir)1102_VPetTTS\plugin\')" />
    <ItemGroup>
      <PluginFiles Include="$(OutputPath)*.dll" Exclude="$(OutputPath)VPet-Simulator*.dll;$(OutputPath)LinePutScript*.dll;$(OutputPath)Panuon*.dll;$(OutputPath)Microsoft.*.dll;$(OutputPath)System.*.dll;$(OutputPath)netstandard.dll" />
      <PluginFiles Include="$(OutputPath)*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(ProjectDir)1102_VPetTTS\plugin\" SkipUnchangedFiles="true" />
    <!-- 原生鉴权组件必须留在 runtimes 目录里：mod_id 是按它所在目录往上找 info.lps 得到的。 -->
    <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\VPetLLM.SecureCommunication.dll"
          DestinationFolder="$(ProjectDir)1102_VPetTTS\plugin\runtimes\win-x64\native"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)runtimes\win-x64\native\VPetLLM.SecureCommunication.dll')" />
    <Copy SourceFiles="$(OutputPath)runtimes\win-x86\native\VPetLLM.SecureCommunication.dll"
          DestinationFolder="$(ProjectDir)1102_VPetTTS\plugin\runtimes\win-x86\native"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)runtimes\win-x86\native\VPetLLM.SecureCommunication.dll')" />
    <Warning Text="警告: 未找到自带的原生鉴权组件 VPetLLM.SecureCommunication.dll，官方服务将不可用"
             Condition="!Exists('$(ProjectDir)1102_VPetTTS\plugin\runtimes\win-x64\native\VPetLLM.SecureCommunication.dll')" />
  </Target>
</Project>