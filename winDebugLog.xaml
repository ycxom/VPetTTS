<Window x:Class="Vpet.Plugin.CustomTTS.winDebugLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        mc:Ignorable="d"
        Title="{ll:Str VPetTTS 调试日志}" 
        Height="550" Width="750"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryLighter}">
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>
    
    <Grid Margin="12" Background="{DynamicResource PrimaryLighter}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{ll:Str VPetTTS 播放器调试信息}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <!-- 播放器状态 -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource DARKPrimaryDark}" 
                BorderThickness="1" 
                CornerRadius="5"
                Background="{DynamicResource PrimaryLight}"
                Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{ll:Str 播放器状态}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="{ll:Str '当前播放器: '}" Width="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCurrentPlayer" Text="{ll:Str 检测中...}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="btnRefreshPlayer" Content="{ll:Str 刷新}" 
                            Click="BtnRefreshPlayer_Click" 
                            Margin="10,0,0,0" Padding="10,3"
                            pu:ButtonHelper.CornerRadius="4"
                            Background="{DynamicResource DARKPrimary}"
                            BorderBrush="{DynamicResource DARKPrimaryDark}"
                            BorderThickness="2"
                            Foreground="{DynamicResource DARKPrimaryText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="{ll:Str 'VPetLLM 插件: '}" Width="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtVPetLLMStatus" Text="{ll:Str 检测中...}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="{ll:Str 'mpv 播放器: '}" Width="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtMpvStatus" Text="{ll:Str 检测中...}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="{ll:Str '推荐播放器: '}" Width="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtRecommendedPlayer" Text="{ll:Str 检测中...}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- 日志区域 -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource DARKPrimaryDark}" 
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 控制按钮 -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource PrimaryLight}" 
                        Padding="8"
                        CornerRadius="5,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnClearLog" Content="{ll:Str 清空日志}" 
                                Click="BtnClearLog_Click" 
                                Margin="0,0,8,0" Padding="12,5"
                                pu:ButtonHelper.CornerRadius="4"
                                Background="{DynamicResource SecondaryLight}"
                                BorderBrush="{DynamicResource SecondaryDark}"
                                BorderThickness="2"/>
                        <Button x:Name="btnTestPlayer" Content="{ll:Str 测试播放器}" 
                                Click="BtnTestPlayer_Click" 
                                Margin="0,0,8,0" Padding="12,5"
                                pu:ButtonHelper.CornerRadius="4"
                                Background="{DynamicResource SecondaryLight}"
                                BorderBrush="{DynamicResource SecondaryDark}"
                                BorderThickness="2"/>
                        <Button x:Name="btnRunDiagnostic" Content="{ll:Str 运行诊断}" 
                                Click="BtnRunDiagnostic_Click" 
                                Margin="0,0,8,0" Padding="12,5"
                                pu:ButtonHelper.CornerRadius="4"
                                Background="{DynamicResource SecondaryLight}"
                                BorderBrush="{DynamicResource SecondaryDark}"
                                BorderThickness="2"/>
                        <pu:Switch x:Name="chkAutoScroll" 
                                   Content="{ll:Str 自动滚动}" 
                                   IsChecked="True" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0"
                                   BorderBrush="{DynamicResource DARKPrimaryDark}"
                                   CheckedBackground="{DynamicResource DARKPrimary}"
                                   CheckedBorderBrush="{DynamicResource DARKPrimary}"
                                   Background="Transparent" 
                                   BoxWidth="35" BoxHeight="18"
                                   ToggleSize="14" ToggleShadowColor="{x:Null}"
                                   ToggleBrush="{DynamicResource DARKPrimaryDark}"
                                   CheckedToggleBrush="{DynamicResource DARKPrimaryText}"/>
                    </StackPanel>
                </Border>
                
                <!-- 日志文本 -->
                <ScrollViewer Grid.Row="1" x:Name="logScrollViewer" Margin="1">
                    <TextBox x:Name="txtLog" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             FontFamily="Consolas" 
                             FontSize="11"
                             Background="{DynamicResource PrimaryLighter}"
                             BorderThickness="0"
                             Margin="5"
                             Padding="5"/>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSaveLog" Content="{ll:Str 保存日志}" 
                    Click="BtnSaveLog_Click" 
                    Margin="0,0,10,0" Padding="15,5"
                    pu:ButtonHelper.CornerRadius="4"
                    Background="{DynamicResource SecondaryLight}"
                    BorderBrush="{DynamicResource SecondaryDark}"
                    BorderThickness="2"/>
            <Button x:Name="btnClose" Content="{ll:Str 关闭}" 
                    Click="BtnClose_Click"
                    Padding="15,5"
                    pu:ButtonHelper.CornerRadius="4"
                    Background="{DynamicResource SecondaryLight}"
                    BorderBrush="{DynamicResource SecondaryDark}"
                    BorderThickness="2"/>
        </StackPanel>
    </Grid>
</Window>
