<Window x:Class="Vpet.Plugin.CustomTTS.winTextFilter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        mc:Ignorable="d"
        Title="{ll:Str 括号过滤设置}"
        Width="460" Height="Auto"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryLighter}">
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{ll:Str 勾选的括号，其内部内容不会被朗读。气泡里依然显示原文，所以动作描写看得到、听不到。}" />

        <Border BorderBrush="{DynamicResource DARKPrimaryDark}"
                BorderThickness="1" CornerRadius="5"
                Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <CheckBox x:Name="RoundBracket" Margin="0,3"
                          Content="{ll:Str 圆括号　( )　（ ）}" />
                <CheckBox x:Name="SquareBracket" Margin="0,3"
                          Content="{ll:Str 方括号　[ ]　【 】　〔 〕}" />
                <!-- 半角花括号在 XAML 标记扩展里是保留字符，文案改用全角回避转义 -->
                <CheckBox x:Name="CurlyBracket" Margin="0,3"
                          Content="{ll:Str 花括号　｛ ｝　半角同样生效}" />
                <CheckBox x:Name="AngleBracket" Margin="0,3"
                          Content="{ll:Str 尖括号　&lt; &gt;　〈 〉　《 》}"
                          ToolTip="{ll:Str 默认关闭：书名号和大于小于号会被误伤}" />
                <CheckBox x:Name="Asterisk" Margin="0,3"
                          Content="{ll:Str 成对星号　*动作*　**动作**}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{ll:Str 自定义括号对（开闭两个字符一组，可用空格分隔）}" Margin="0,0,0,3" />
        <TextBox x:Name="CustomPairs" Margin="0,0,0,10" Padding="5,3"
                 VerticalContentAlignment="Center"
                 ToolTip="{ll:Str 例如：「」『』}" />

        <TextBlock Text="{ll:Str 效果预览}" Margin="0,0,0,3" />
        <TextBox x:Name="PreviewInput" Margin="0,0,0,5" Padding="5,3"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Height="50" VerticalScrollBarVisibility="Auto" />
        <Border BorderBrush="{DynamicResource DARKPrimaryDark}"
                BorderThickness="1" CornerRadius="5"
                Margin="0,0,0,10" Padding="8" MinHeight="40">
            <TextBlock x:Name="PreviewOutput" TextWrapping="Wrap"
                       Foreground="{DynamicResource DARKPrimaryDarker}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Cancel" Content="{ll:Str 取消}"
                    pu:ButtonHelper.CornerRadius="4"
                    Background="{DynamicResource SecondaryLight}"
                    BorderBrush="{DynamicResource SecondaryDark}"
                    BorderThickness="2"
                    Margin="5" Padding="15,5"
                    Click="Cancel_Click" />
            <Button x:Name="Confirm" Content="{ll:Str 确定}"
                    pu:ButtonHelper.CornerRadius="4"
                    Background="{DynamicResource DARKPrimary}"
                    BorderBrush="{DynamicResource DARKPrimaryDark}"
                    BorderThickness="2"
                    Foreground="{DynamicResource DARKPrimaryText}"
                    Margin="5" Padding="15,5"
                    Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
